{
  "schema_version": 1,
  "model": "act",
  "backend": "robot_learning.integrations.http_services:HttpPolicyBackend",
  "joint_names": [
    "joint_1",
    "joint_2",
    "joint_3",
    "joint_4",
    "joint_5",
    "joint_6"
  ],
  "joint_units": "rad",
  "action_units": "rad",
  "camera_map": {
    "head": "head_camera",
    "wrist": "left_wrist_camera"
  },
  "gripper_in_action": false,
  "image_format": "frame",
  "backend_options": {
    "endpoint": "https://model.example/api/infer",
    "timeout_seconds": 10,
    "api_key_env": "ROBOT_POLICY_API_KEY"
  }
}
